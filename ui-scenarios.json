{
  "scenarios": [
    {
      "name": "another member's prospect opens read-only until the configured committee group contains you",
      "members": {
        "viewer": "adult",
        "other": "adult"
      },
      "steps": [
        {
          "action": "seedGroup",
          "group": "social",
          "name": "Social Committee",
          "members": [
            "other"
          ]
        },
        {
          "action": "seedGroup",
          "group": "rush",
          "name": "Recruitment Committee",
          "members": [
            "viewer"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_recruitment_tracker__settings (key, value) VALUES ('committee_group_id', ?)",
          "params": [
            "{{group:social}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_recruitment_tracker__prospects (id, name, year, contact, source, stage, notes, created_by, created_at, updated_at, visibility) VALUES (?, ?, ?, ?, ?, 'rushed', ?, ?, datetime('now'), datetime('now'), 'everyone')",
          "params": [
            "ui-prospect",
            "Jordan Prospect",
            "Sophomore",
            "jordan@example.com",
            "Referred by a neighbour",
            "Attended two events.",
            "{{other}}"
          ]
        },
        {
          "action": "open",
          "as": "viewer"
        },
        {
          "action": "expectVisible",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-card\"][data-prospect-id=\"ui-prospect\"]"
        },
        {
          "action": "click",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-card\"][data-prospect-id=\"ui-prospect\"]"
        },
        {
          "action": "expectVisible",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-modal\"][data-prospect-id=\"ui-prospect\"]"
        },
        {
          "action": "expectCount",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-modal\"][data-prospect-id=\"ui-prospect\"][data-can-manage=\"1\"]",
          "count": 0
        },
        {
          "action": "expectVisible",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-modal\"][data-prospect-id=\"ui-prospect\"][data-can-manage=\"0\"]"
        },
        {
          "action": "seedRaw",
          "sql": "UPDATE app_recruitment_tracker__settings SET value = ? WHERE key = 'committee_group_id'",
          "params": [
            "{{group:rush}}"
          ]
        },
        {
          "action": "reload",
          "as": "viewer"
        },
        {
          "action": "expectVisible",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-card\"][data-prospect-id=\"ui-prospect\"]"
        },
        {
          "action": "click",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-card\"][data-prospect-id=\"ui-prospect\"]"
        },
        {
          "action": "expectVisible",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-modal\"][data-prospect-id=\"ui-prospect\"][data-can-manage=\"1\"]"
        },
        {
          "action": "expectCount",
          "as": "viewer",
          "selector": "[data-testid=\"prospect-modal\"][data-prospect-id=\"ui-prospect\"][data-can-manage=\"0\"]",
          "count": 0
        }
      ]
    }
  ]
}
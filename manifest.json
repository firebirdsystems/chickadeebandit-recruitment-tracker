{
  "id": "recruitment-tracker",
  "contexts": ["household", "shared_space"],
  "name": "Recruitment Tracker",
  "version": "1.1.0",
  "description": "Manage rush and recruitment pipeline: add prospects, move them through stages (invited → rushed → bid → pledged), record secret votes and notes.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["recruitment", "rush", "greek", "pipeline", "prospects"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "prospects": {"sql": "SELECT * FROM app_recruitment_tracker__prospects ORDER BY created_at"},
    "vote_receipts": {"sql": "SELECT prospect_id FROM app_recruitment_tracker__vote_receipts"},
    "prospect_activity": {"sql": "SELECT * FROM app_recruitment_tracker__prospect_activity ORDER BY created_at DESC LIMIT 50"},
    "settings": {"sql": "SELECT value FROM app_recruitment_tracker__settings WHERE key = 'committee_group_id'"},
    "decisions": {"sql": "SELECT prospect_id, decision, decided_by, decided_at FROM app_recruitment_tracker__decisions"}
  },
  "member_references": {
    "prospects": { "column": "created_by", "on_removed": "keep" },
    "votes": { "column": "voter_id", "on_removed": "keep" },
    "prospect_activity": { "column": "actor_id", "on_removed": "keep" },
    "vote_receipts": { "column": "member_id", "on_removed": "keep" },
    "decisions": { "column": "decided_by", "on_removed": "keep" }
  },
  "delete_cascades": {
    "prospects": [
      { "table": "ballots", "foreign_key": "prospect_id" },
      { "table": "vote_receipts", "foreign_key": "prospect_id" }
    ]
  },
  "kiosk": "never",
  "resource_limits": { "max_db_bytes": 52428800 },
  "nav": { "label": "Recruitment" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_recruitment_tracker__prospects p LEFT JOIN app_recruitment_tracker__vote_receipts r ON r.prospect_id = p.id LEFT JOIN app_recruitment_tracker__decisions d ON d.prospect_id = p.id WHERE p.vote_status = 'open' AND p.stage <> 'dropped' AND r.member_id IS NULL AND d.prospect_id IS NULL LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "prospects awaiting your vote",
      "severity": "info"
    }
  },
  "publishes": ["recruitment.decision_recorded"],
  "publish_acls": {
    "recruitment.decision_recorded": {
      "require_group_setting": { "settings_table": "settings", "settings_key": "committee_group_id" }
    }
  },
  "automation_actions": {
    "add_prospect": {
      "title": "Add a prospect",
      "description": "Open a recruitment file when another app's event carries an interested person - an application submitted, a name passed along by a member.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Owned by",
          "required": true
        },
        "name": {
          "type": "text",
          "label": "Prospect name",
          "required": true
        },
        "year": {
          "type": "text",
          "label": "Year",
          "default": ""
        },
        "contact": {
          "type": "text",
          "label": "Contact",
          "default": ""
        },
        "source": {
          "type": "text",
          "label": "Where they came from",
          "default": ""
        },
        "notes": {
          "type": "text",
          "label": "Notes",
          "default": ""
        }
      },
      "dedupe": {
        "table": "prospects",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "prospects",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "year": ":year",
            "contact": ":contact",
            "source": ":source",
            "notes": ":notes",
            "created_by": ":created_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "icon": "🎓",
  "db_plaintext_columns": ["stage", "vote", "vote_status", "decision"],
  "row_policies": {
    "settings": { "kind": "app_config" },
    "prospects": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "privileged_groups": [{ "settings_table": "settings", "settings_key": "committee_group_id" }]
    },
    "ballots": {
      "kind": "endpoint_only"
    },
    "vote_receipts": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "member_can_update": false,
      "endpoint_writes_only": true
    },
    "votes": {
      "kind": "endpoint_only",
      "read": "none"
    },
    "prospect_activity": {
      "kind": "owner_or_visibility",
      "member_column": "actor_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true
    },
    "decisions": {
      "kind": "inherit_visibility",
      "fk_column": "prospect_id",
      "parent_table": "prospects",
      "writer_column": "decided_by",
      "insert_privileged_only": true
    }
  },
  "anonymous_responses": {
    "receipt_table": "vote_receipts",
    "session_column": "prospect_id",
    "member_column": "member_id",
    "created_at_column": "created_at",
    "response_table": "ballots",
    "response_session_column": "prospect_id",
    "response_answer_column": "vote",
    "response_id_column": "id",
    "response_created_at_column": "created_at",
    "session_table": "prospects",
    "session_id_column": "id",
    "session_status_column": "vote_status",
    "session_open_value": "open"
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": ["committee_group_id"]
  },
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["prospects_summary"],
    "db_inserts": ["add_prospect"]
  }
}
